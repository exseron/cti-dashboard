# ---- Kimlik doğrulama ----
# 1 = auth kapalı (varsayılan). Basic Auth istiyorsanız 0 yapıp aşağıdaki kullanıcı/şifreyi doldurun.
ALLOW_NO_AUTH=1
APP_USERNAME=analyst
APP_PASSWORD=change-me-to-a-long-random-password

# ---- Sunucu ----
HOST=0.0.0.0
PORT=8000
# Reverse proxy (Caddy/nginx) IP'si. Docker compose'da Caddy ağı için "*" kullanılır,
# uygulama portunu doğrudan internete açıyorsanız 127.0.0.1 bırakın.
FORWARDED_ALLOW_IPS=127.0.0.1

# ---- Opsiyonel API anahtarları (rate limit'i ciddi şekilde artırır) ----
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Yetkisiz (scope'suz) bir GitHub fine-grained token yeterli
GITHUB_TOKEN=

# ---- Opsiyonel: Claude ile haber özetleri ----
# ANTHROPIC_API_KEY ayarlanırsa (LLM_SUMMARY=auto) haberler Claude ile özetlenir ve etiketlenir.
ANTHROPIC_API_KEY=
LLM_SUMMARY=auto
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
SUMMARY_LANGUAGE=Turkish
# Her yenileme döngüsünde en fazla kaç yeni haber özetlensin (maliyet kontrolü)
LLM_MAX_PER_CYCLE=40

# ---- Yenileme / pencere ----
NEWS_REFRESH_MINUTES=30
NEWS_MAX_AGE_DAYS=14
CVE_REFRESH_MINUTES=60
CVE_DAYS=7
ATTACK_REFRESH_DAYS=7

# ---- Docker compose + Caddy (otomatik Let's Encrypt) ----
DOMAIN=cti.example.com
